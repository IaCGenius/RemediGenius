# Copy to an ignored private .tfvars file and replace EVERY placeholder.
# Provision CE in YOUR account/region; us-east-1 is an example, not a restriction.
account_id            = "YOUR_ACCOUNT_ID"
region                = "us-east-1"
# Existing subnet and private bucket in the deployment region.
subnet_id             = "YOUR_SUBNET_ID"
bucket_name           = "YOUR_PRIVATE_BUCKET"
workspace_prefix      = "ce"
name                  = "rgce-native"
running               = false
instance_type         = "t3.large"
spot_instance_types   = ["t3.large", "t3a.large"]
container_memory_mb   = 6144
source_archive_key    = "native-source/YOUR_DIGEST.zip"
source_archive_sha256 = "YOUR_64_CHARACTER_SHA256"
# Your raw API key in Secrets Manager; only the ARN belongs here.
# Model identifier and compatible HTTPS endpoint are yours; no Qwen key is bundled.
model_secret_arn       = "YOUR_SECRET_ARN"
model_name            = "YOUR_MODEL_NAME"
model_base_url        = "https://YOUR_PROVIDER/v1"
# Empty map uses the deployment account and region.
aws_read_targets      = {}
knowledge_view        = ""

# Background AWS reads are separate from agent compute; no scheduled model calls.
schedule_enabled = false
schedule_interval_hours = 24
# With named aws_read_targets, supply scheduled_checks using those aliases/regions.
# Full input meanings: docs/ONBOARDING.md

# false requires private-subnet outbound connectivity; true for public subnet without NAT.
associate_public_ip = false
