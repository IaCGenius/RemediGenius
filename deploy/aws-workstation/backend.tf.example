# Copy to backend.tf BEFORE init; use a separate pre-existing private state bucket.
# No credentials here. Enable bucket versioning, encryption and public-access block.
terraform {
  backend "s3" {
    bucket = "REPLACE-state-bucket"
    key = "ce/aws-workstation/terraform.tfstate"
    region = "us-east-1"
    encrypt = true
    use_lockfile = true
  }
}
# Existing local state: terraform init -migrate-state (review and back up first).
