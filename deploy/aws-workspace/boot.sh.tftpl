#!/bin/bash
set -euo pipefail
dnf install -y docker
systemctl enable --now docker
aws s3 cp 's3://${bucket}/${image_key}' /var/tmp/rgce-image.tar.gz --region '${region}' --only-show-errors
echo '${image_sha}  /var/tmp/rgce-image.tar.gz' | sha256sum -c -
docker load -i /var/tmp/rgce-image.tar.gz
docker run -d --name rgce --restart unless-stopped --read-only --cap-drop ALL \
  --security-opt no-new-privileges --init \
  --tmpfs /data:rw,uid=10001,gid=10001,mode=0700 \
  --tmpfs /tmp:rw,noexec,nosuid,nodev,size=64m \
  -p 127.0.0.1:8765:8765 \
  -e RGCE_STORAGE_BUCKET='${bucket}' -e RGCE_STORAGE_PREFIX='${prefix}' \
  -e AWS_DEFAULT_REGION='${region}' '${image_tag}'
