#!/bin/bash
# Hermes host bootstrap, rendered by Terraform templatefile(). Runs on every boot.
# Deliberately thin: persist the Terraform values,
# get the boot scripts from S3, hand over to dist/boot.sh. Change boot.sh, not this file.
# Template rule: a dollar-brace in this file is a Terraform interpolation, even in comments.
set -uo pipefail
exec > /var/log/user-data.log 2>&1
echo "=== remedigenius-community user-data $(date -u +%FT%TZ) ==="

cat > /etc/rg-hermes.env <<ENV
REGION="${region}"
BUCKET="${bucket}"
DATA_VOLUME_ID="${data_volume_id}"
SECRET_MODEL="${secret_model}"
SECRET_LOGIN="${secret_login}"
HERMES_IMAGE="${hermes_image}"
DASHBOARD_PORT="${dashboard_port}"
NAME_PREFIX="${name_prefix}"
SCHEDULE_ENABLED="${schedule_enabled}"
COLLECT_ON_CALENDAR="${collect_on_calendar}"
ENV
chmod 0644 /etc/rg-hermes.env

if ! command -v aws >/dev/null 2>&1; then
  apt-get update -qq && apt-get install -y -qq unzip curl jq >/dev/null
  curl -fsSL https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip -o /tmp/awscliv2.zip
  unzip -q /tmp/awscliv2.zip -d /tmp && /tmp/aws/install && rm -rf /tmp/aws /tmp/awscliv2.zip
fi

mkdir -p /opt/rg/dist
aws s3 sync "s3://${bucket}/engine-code/dist/" /opt/rg/dist/ --region "${region}" --delete
chmod +x /opt/rg/dist/*.sh
/opt/rg/dist/boot.sh
echo "=== user-data done $(date -u +%FT%TZ) ==="
