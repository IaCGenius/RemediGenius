{
  "Comment": "Kiosk gate: validate, test in the sandbox, sign, deploy. A refusal ends SUCCEEDED with verdict FAIL; a platform fault fails the execution (alert).",
  "StartAt": "Validate",
  "States": {
    "Validate": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${gate}",
        "Payload": {
          "action": "validate",
          "bundle_key.$": "$.bundle_key"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "ResultSelector": {
        "v.$": "$.Payload"
      },
      "ResultPath": "$.validate",
      "Catch": [
        {
          "ErrorEquals": [
            "Refused"
          ],
          "ResultPath": "$.error",
          "Next": "Refuse"
        }
      ],
      "Next": "Test"
    },
    "Test": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${gate}",
        "Payload": {
          "action": "test",
          "bundle_key.$": "$.bundle_key",
          "validate.$": "$.validate.v"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "ResultSelector": {
        "t.$": "$.Payload"
      },
      "ResultPath": "$.test",
      "Catch": [
        {
          "ErrorEquals": [
            "Refused"
          ],
          "ResultPath": "$.error",
          "Next": "Refuse"
        }
      ],
      "Next": "Sign"
    },
    "Sign": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${gate}",
        "Payload": {
          "action": "sign",
          "bundle_key.$": "$.bundle_key",
          "validate.$": "$.validate.v"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "ResultSelector": {
        "job_id.$": "$.Payload.job_id",
        "attempts.$": "$.Payload.attempts"
      },
      "ResultPath": "$.sign",
      "Next": "WaitSign"
    },
    "WaitSign": {
      "Type": "Wait",
      "Seconds": 5,
      "Next": "SignStatus"
    },
    "SignStatus": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${gate}",
        "Payload": {
          "action": "sign_status",
          "job_id.$": "$.sign.job_id",
          "attempts.$": "$.sign.attempts"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "ResultSelector": {
        "job_id.$": "$.Payload.job_id",
        "status.$": "$.Payload.status",
        "signed_key.$": "$.Payload.signed_key",
        "attempts.$": "$.Payload.attempts"
      },
      "ResultPath": "$.sign",
      "Next": "SignChoice"
    },
    "SignChoice": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.sign.status",
          "StringEquals": "Succeeded",
          "Next": "Deploy"
        }
      ],
      "Default": "WaitSign"
    },
    "Deploy": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${gate}",
        "Payload": {
          "action": "deploy",
          "bundle_key.$": "$.bundle_key",
          "validate.$": "$.validate.v",
          "test.$": "$.test.t",
          "signed_key.$": "$.sign.signed_key"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "Refused"
          ],
          "ResultPath": "$.error",
          "Next": "Refuse"
        }
      ],
      "End": true,
      "OutputPath": "$.Payload"
    },
    "Refuse": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${gate}",
        "Payload": {
          "action": "refuse",
          "bundle_key.$": "$.bundle_key",
          "error.$": "$.error"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "OutputPath": "$.Payload",
      "End": true
    }
  }
}
