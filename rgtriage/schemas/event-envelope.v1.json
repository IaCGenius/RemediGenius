{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:remedigenius-ce:event-envelope:1",
  "title": "RemediGenius-CE event envelope v1",
  "description": "One committed fact in the CE Iceberg tables. Events are immutable; corrections and retractions are new events that link back.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "schema_version", "event_id", "kind", "installation_id", "epoch", "sequence",
    "scope", "observed_at", "ingested_at", "payload_hash", "raw_ref", "corrects", "retracts", "batch_id"
  ],
  "properties": {
    "contract": {"const": "remedigenius-ce-storage/1"},
    "schema_version": {"const": 1},
    "event_id": {
      "type": "string",
      "pattern": "^(evt_[0-9a-f]{32}|[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12})$"
    },
    "kind": {
      "enum": ["observation", "coverage", "scan_run", "signal", "verification_attempt", "fix_event", "decision", "github_intent", "github_result"]
    },
    "installation_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "epoch": {"type": "string", "minLength": 1, "maxLength": 128},
    "sequence": {"type": "integer", "minimum": 0},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["account", "region", "source", "filter_hash"],
      "properties": {
        "account": {"type": "string", "maxLength": 128, "pattern": "^[A-Za-z0-9._-]*$"},
        "region": {"type": "string", "maxLength": 128, "pattern": "^[A-Za-z0-9._-]*$"},
        "source": {"type": "string", "maxLength": 128, "pattern": "^[A-Za-z0-9._-]*$"},
        "filter_hash": {"type": "string", "pattern": "^(|[0-9a-f]{64})$"}
      }
    },
    "observed_at": {"$ref": "#/$defs/timestamp"},
    "ingested_at": {"$ref": "#/$defs/timestamp"},
    "payload_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "raw_ref": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "urn:remedigenius-ce:raw-ref:1"}
      ]
    },
    "corrects": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "retracts": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "batch_id": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^batch_[0-9a-f]{32}$"}]}
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    }
  }
}